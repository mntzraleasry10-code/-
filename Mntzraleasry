# ============================================================
#  DATABASE LAYER
# ============================================================
class DB:
    _conn = None

    @classmethod
    def init(cls):
        app = App.get_running_app()
        path = os.path.join(app.user_data_dir, DB_NAME) if app else DB_NAME
        cls._conn = sqlite3.connect(path)
        cls._conn.row_factory = sqlite3.Row
        cls._conn.execute("PRAGMA foreign_keys = ON")
        cls._conn.executescript("""
        CREATE TABLE IF NOT EXISTS patients(
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT NOT NULL,
            phone TEXT UNIQUE NOT NULL,
            email TEXT,
            password TEXT NOT NULL,
            created_at TEXT
        );
        CREATE TABLE IF NOT EXISTS doctors(
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT NOT NULL,
            specialty TEXT NOT NULL,
            clinic TEXT NOT NULL,
            city TEXT NOT NULL,
            address TEXT NOT NULL,
            fee INTEGER NOT NULL,
            experience_years INTEGER DEFAULT 0,
            qualification TEXT,
            working_hours TEXT,
            lat REAL, lng REAL,
            rating REAL DEFAULT 0,
            rating_count INTEGER DEFAULT 0
        );
        CREATE TABLE IF NOT EXISTS slots(
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            doctor_id INTEGER NOT NULL,
            date TEXT NOT NULL,
            time TEXT NOT NULL,
            booked INTEGER DEFAULT 0,
            UNIQUE(doctor_id, date, time),
            FOREIGN KEY(doctor_id) REFERENCES doctors(id) ON DELETE CASCADE
        );
        CREATE TABLE IF NOT EXISTS appointments(
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            doctor_id INTEGER NOT NULL,
            patient_id INTEGER NOT NULL,
            slot_id INTEGER NOT NULL UNIQUE,
            status TEXT DEFAULT 'booked',
            created_at TEXT,
            FOREIGN KEY(doctor_id) REFERENCES doctors(id) ON DELETE CASCADE,
            FOREIGN KEY(patient_id) REFERENCES patients(id) ON DELETE CASCADE,
            FOREIGN KEY(slot_id) REFERENCES slots(id) ON DELETE CASCADE
        );
        CREATE TABLE IF NOT EXISTS reviews(
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            doctor_id INTEGER NOT NULL,
            patient_id INTEGER NOT NULL,
            rating INTEGER NOT NULL,
            comment TEXT,
            created_at TEXT,
            FOREIGN KEY(doctor_id) REFERENCES doctors(id) ON DELETE CASCADE,
            FOREIGN KEY(patient_id) REFERENCES patients(id) ON DELETE CASCADE
        );
        """)
        cls._conn.commit()
        cls._seed()

    @classmethod
    def _seed(cls):
        c = cls._conn.cursor()
        c.execute("SELECT COUNT(*) FROM doctors")
        if c.fetchone()[0] > 0:
            return
        doctors = [
            ("Dr. Ahmed Al-Khafaji", "Cardiology", "Al-Salam Clinic", "Baghdad",
             "Karrada, St 14", 25000, 12, "MBChB, FIBMS Cardiology", "9:00-15:00",
             33.3015, 44.4215),
            ("Dr. Sara Hassan", "Dermatology", "Skin Care Center", "Baghdad",
             "Mansour, 14 Ramadan St", 20000, 8, "MBChB, Diploma Dermatology", "10:00-17:00",
             33.3125, 44.3412),
            ("Dr. Ali Jabbar", "Pediatrics", "Child Health Clinic", "Basra",
             "Al-Jazaer, Main St", 15000, 10, "MBChB, CABP", "8:00-14:00",
             30.5085, 47.7804),
            ("Dr. Noor Al-Zubaidi", "Orthopedics", "Bone & Joint Clinic", "Erbil",
             "Citadel Road", 30000, 15, "MBChB, FRCS Ortho", "9:00-16:00",
             36.1911, 44.0095),
            ("Dr. Mustafa Kamal", "General Medicine", "Al-Noor Clinic", "Najaf",
             "Kufa St", 10000, 5, "MBChB", "8:00-13:00",
             32.0018, 44.3300),
            ("Dr. Lina Kareem", "Ophthalmology", "Eye Care Center", "Baghdad",
             "Zayouna, Main Rd", 22000, 7, "MBChB, Diploma Ophth", "10:00-16:00",
             33.3320, 44.4655),
            ("Dr. Haider Al-Saadi", "ENT", "ENT Clinic", "Karbala",
             "Al-Abbas St", 18000, 9, "MBChB, FIBMS ENT", "9:00-15:00",
             32.6160, 44.0249),
        ]
        c.executemany("""INSERT INTO doctors(name,specialty,clinic,city,address,fee,
                         experience_years,qualification,working_hours,lat,lng)
                         VALUES(?,?,?,?,?,?,?,?,?,?,?)""", doctors)
        c.execute("SELECT id FROM doctors")
        doc_ids = [r[0] for r in c.fetchall()]
        times = ["09:00","10:00","11:00","12:00","16:00","17:00","18:00"]
        today = date.today()
        rows = []
        for did in doc_ids:
            for i in range(10):
                dstr = (today + timedelta(days=i)).strftime("%Y-%m-%d")
                for t in times:
                    rows.append((did, dstr, t))
        c.executemany("INSERT INTO slots(doctor_id,date,time) VALUES(?,?,?)", rows)
        cls._conn.commit()

    @classmethod
    def q(cls, sql, params=()):
        return cls._conn.execute(sql, params).fetchall()

    @classmethod
    def q1(cls, sql, params=()):
        return cls._conn.execute(sql, params).fetchone()

    @classmethod
    def ex(cls, sql, params=()):
        cur = cls._conn.execute(sql, params)
        cls._conn.commit()
        return cur.lastrowid


