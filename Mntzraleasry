        # Clinic info
        info = card()
        info.add_widget(lbl('Clinic', size=13, bold=True))
        info.add_widget(lbl(d['clinic'], size=13))
        info.add_widget(lbl(f"{d['address']}, {d['city']}", size=12, color=C_MUTED))
        info.add_widget(lbl(f"Working hours: {d['working_hours']}", size=12, color=C_MUTED))
        info.add_widget(lbl(f"Fee: {d['fee']} IQD", size=13, bold=True, color=C_SECONDARY))
        if d['qualification']:
            info.add_widget(lbl(f"Qualifications: {d['qualification']}", size=12, color=C_MUTED))

        dir_b = btn('📍 Get Directions (Google Maps)', bg=C_SECONDARY, height=dp(38),
                    on_press=lambda: self.open_maps(d['lat'], d['lng'], d['clinic']))
        info.add_widget(dir_b)
        inner.add_widget(info)

        # Available slots
        inner.add_widget(lbl('Available Slots', size=16, bold=True))
        today = date.today().strftime("%Y-%m-%d")
        slots = DB.q("SELECT * FROM slots WHERE doctor_id=? AND booked=0 AND date>=? ORDER BY date, time LIMIT 60",
                     (self.doctor_id, today))
        if not slots:
            inner.add_widget(lbl('No available slots', color=C_MUTED, size=13))
        else:
            by_date = {}
            for s in slots:
                by_date.setdefault(s['date'], []).append(s)
            for dstr, ss in list(by_date.items())[:5]:
                day_card = card()
                day_card.add_widget(lbl(dstr, size=13, bold=True, color=C_PRIMARY))
                grid = GridLayout(cols=4, size_hint_y=None, spacing=dp(4),
                                  height=dp(40) * ((len(ss)+3)//4))
                for s in ss:
                    b = Button(text=s['time'], background_normal='',
                               background_color=get_color_from_hex('#EAF2FA'),
                               color=C_PRIMARY, font_size=sp(12))
                    b.bind(on_release=lambda btn, sid=s['id'], ds=dstr, tm=s['time']:
                           self.confirm_booking(d['id'], sid, d['name'], ds, tm))
                    grid.add_widget(b)
                day_card.add_widget(grid)
                inner.add_widget(day_card)

        # Rate button
        self.root_box.add_widget(btn('⭐ Rate this Doctor', bg=C_SECONDARY,
                                     on_press=lambda: self.rate_dialog(d['id'])))

    def open_maps(self, lat, lng, name):
        if lat and lng:
            url = f"https://www.google.com/maps/search/?api=1&query={lat},{lng}"
        else:
            url = f"https://www.google.com/maps/search/{name.replace(' ', '+')}"
        webbrowser.open(url)

    def confirm_booking(self, did, sid, dname, ddate, dtime):
        from app_globals import AppState
        content = BoxLayout(orientation='vertical', padding=dp(10), spacing=dp(8))
        content.add_widget(lbl(f"Doctor: {dname}", size=13))
        content.add_widget(lbl(f"Date: {ddate}", size=13))
        content.add_widget(lbl(f"Time: {dtime}", size=13))
        content.add_widget(Label())
        row = BoxLayout(size_hint_y=None, height=dp(44), spacing=dp(6))
        pop = Popup(title='Confirm Booking', content=content,
                    size_hint=(0.85, 0.5))
        ok = btn('Confirm', bg=C_SECONDARY, on_press=lambda: self.do_book(did, sid, pop))
        no = btn('Cancel', bg=C_MUTED, on_press=lambda: pop.dismiss())
        row.add_widget(no); row.add_widget(ok)
        content.add_widget(row)
        pop.open()

    def do_book(self, did, sid, popup):
        from app_globals import AppState
        try:
            # Double-booking prevention: UNIQUE constraint on slot_id
            # First mark slot booked atomically (only if still free)
            cur = DB._conn.execute("UPDATE slots SET booked=1 WHERE id=? AND booked=0", (sid,))
            DB._conn.commit()
            if cur.rowcount == 0:
                popup.dismiss()
                toast('This slot is already booked. Choose another.')
                return
            DB.ex("INSERT INTO appointments(doctor_id,patient_id,slot_id,status,created_at) VALUES(?,?,?,?,?)",
                  (did, AppState.patient_id, sid, 'booked', datetime.now().isoformat()))
            popup.dismiss()
            toast('Booking confirmed!')
            self.build()
        except sqlite3.IntegrityError:
            DB._conn.execute("UPDATE slots SET booked=0 WHERE id=?", (sid,))
            DB._conn.commit()
            popup.dismiss()
            toast('This slot is already booked.')

    def rate_dialog(self, did):
        content = BoxLayout(orientation='vertical', padding=dp(10), spacing=dp(8))
        content.add_widget(lbl('Rating (1-5):', size=13))
        spinner = Spinner(text='5', values=['1','2','3','4','5'],
                          size_hint_y=None, height=dp(44))
        comment = TextInput(hint_text='Comment (optional)', multiline=False,
                            size_hint_y=None, height=dp(44))
        content.add_widget(spinner)
        content.add_widget(comment)
        pop = Popup(title='Rate Doctor', content=content, size_hint=(0.85, 0.5))
        row = BoxLayout(size_hint_y=None, height=dp(44), spacing=dp(6))
        row.add_widget(btn('Cancel', bg=C_MUTED, on_press=lambda: pop.dismiss()))
        row.add_widget(btn('Submit', bg=C_SECONDARY,
                           on_press=lambda: self.submit_rating(did, int(spinner.text),
                                                               comment.text, pop)))
        content.add_widget(row)
        pop.open()

    def submit_rating(self, did, stars, comment, popup):
        from app_globals import AppState
        DB.ex("INSERT INTO reviews(doctor_id,patient_id,rating,comment,created_at) VALUES(?,?,?,?,?)",
              (did, AppState.patient_id, stars, comment, datetime.now().isoformat()))
        row = DB.q1("SELECT rating, rating_count FROM doctors WHERE id=?", (did,))
        new_count = row['rating_count'] + 1
        new_avg = (row['rating'] * row['rating_count'] + stars) / new_count
        DB.ex("UPDATE doctors SET rating=?, rating_count=? WHERE id=?",
              (new_avg, new_count, did))
        popup.dismiss()
        toast('Thank you for rating!')
        self.build()


class AppointmentsScreen(Screen):
    def __init__(self, **kw):
        super().__init__(**kw)
        self.root_box = BoxLayout(orientation='vertical')
        self.add_widget(self.root_box)

    def on_pre_enter(self):
        self.build()

    def build(self):
        from app_globals import AppState
        self.root_box.clear_widgets()
        self.root_box.add_widget(topbar('My Appointments',
                                        on_back=lambda: setattr(self.manager, 'current', 'home')))
        sv, inner = scroll()
        self.root_box.add_widget(sv)

        rows = DB.q("""SELECT a.id, a.status, s.date, s.time, s.id as sid,
                              d.name as dname, d.clinic, d.specialty, d.id as did
                       FROM appointments a
                       JOIN slots s ON s.id=a.slot_id
                       JOIN doctors d ON d.id=a.doctor_id
                       WHERE a.patient_id=?
                       ORDER BY CASE WHEN a.status='booked' THEN 0 ELSE 1 END, s.date DESC""",
                    (AppState.patient_id,))
        if not rows:
            empty = card()
            empty.add_widget(lbl('You have no appointments yet.', size=14,
                                 color=C_MUTED, halign='center'))
            inner.add_widget(empty)
            return
        for r in rows:
            c = card(height=dp(140))
            c.add_widget(lbl(r['dname'], size=14, bold=True))
            c.add_widget(lbl(f"{r['specialty']} • {r['clinic']}", size=12, color=C_MUTED))
            c.add_widget(lbl(f"📅 {r['date']}  🕒 {r['time']}", size=13))
            status_text = '✅ Booked' if r['status'] == 'booked' else '❌ Cancelled'
            c.add_widget(lbl(status_text, size=12,
                             color=C_SECONDARY if r['status']=='booked' else C_DANGER))
            if r['status'] == 'booked':
                row = BoxLayout(size_hint_y=None, height=dp(38), spacing=dp(4))
                row.add_widget(btn('Cancel', bg=C_DANGER, height=dp(34),
                                   on_press=lambda *a, aid=r['id'], sid=r['sid']: self.cancel(aid, sid)))
                row.add_widget(btn('Reschedule', bg=C_SECONDARY, height=dp(34),
                                   on_press=lambda *a, did=r['did'], aid=r['id'], sid=r['sid']:
                                   self.reschedule(did, aid, sid)))
                c.add_widget(row)
            inner.add_widget(c)

    def cancel(self, aid, sid):
        def _do(popup):
            DB.ex("UPDATE appointments SET status='cancelled' WHERE id=?", (aid,))
            DB.ex("UPDATE slots SET booked=0 WHERE id=?", (sid,))
            popup.dismiss()
            toast('Appointment cancelled')
            self.build()
        content = BoxLayout(orientation='vertical', padding=dp(10), spacing=dp(8))
        content.add_widget(lbl('Cancel this appointment?', size=14))
        pop = Popup(title='Confirm', content=content, size_hint=(0.8, 0.4))
        row = BoxLayout(size_hint_y=None, height=dp(44), spacing=dp(6))
        row.add_widget(btn('No', bg=C_MUTED, on_press=lambda: pop.dismiss()))
        row.add_widget(btn('Yes, Cancel', bg=C_DANGER, on_press=lambda: _do(pop)))
        content.add_widget(row)
        pop.open()

    def reschedule(self, did, aid, sid):
        # Free old slot, cancel old appt, open doctor profile
        DB.ex("UPDATE appointments SET status='cancelled' WHERE id=?", (aid,))
        DB.ex("UPDATE slots SET booked=0 WHERE id=?", (sid,))
        self.manager.get_screen('doctor').doctor_id = did
        toast('Old slot released. Pick a new one.')
        self.manager.current = 'doctor'


