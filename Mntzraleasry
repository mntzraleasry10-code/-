def card(bg=C_CARD, radius=dp(12), pad=dp(10), height=None, spacing=dp(6)):
    box = BoxLayout(orientation='vertical', padding=pad, spacing=spacing,
                    size_hint_y=None)
    if height:
        box.height = height
    with box.canvas.before:
        Color(*bg)
        box.rect = RoundedRectangle(pos=box.pos, size=box.size, radius=[radius])
    box.bind(pos=lambda *a: setattr(box.rect, 'pos', box.pos))
    box.bind(size=lambda *a: setattr(box.rect, 'size', box.size))
    return box

def lbl(text, color=C_TEXT, size=14, bold=False, wrap=False, halign='left'):
    l = Label(text=text, color=color, font_size=sp(size),
              bold=bold, halign=halign, valign='middle')
    if wrap:
        l.bind(width=lambda *a: setattr(l, 'text_size', (l.width, None)))
    return l

def btn(text, bg=C_PRIMARY, fg=(1,1,1,1), height=dp(44), on_press=None, size_hint_x=1):
    b = Button(text=text, background_normal='', background_color=bg,
               color=fg, font_size=sp(14), bold=True,
               size_hint_y=None, height=height, size_hint_x=size_hint_x)
    if on_press:
        b.bind(on_release=lambda *a: on_press())
    return b

def topbar(title, on_back=None, right_widget=None):
    bar = BoxLayout(orientation='horizontal', size_hint_y=None, height=dp(56),
                    padding=[dp(8), dp(8)], spacing=dp(6))
    with bar.canvas.before:
        Color(*C_PRIMARY)
        bar.rect = Rectangle(pos=bar.pos, size=bar.size)
    bar.bind(pos=lambda *a: setattr(bar.rect, 'pos', bar.pos))
    bar.bind(size=lambda *a: setattr(bar.rect, 'size', bar.size))
    if on_back:
        back = Button(text='<', font_size=sp(22), bold=True,
                      background_normal='', background_color=C_PRIMARY,
                      color=(1,1,1,1), size_hint_x=None, width=dp(44))
        back.bind(on_release=lambda *a: on_back())
        bar.add_widget(back)
    else:
        bar.add_widget(Label(size_hint_x=None, width=dp(8)))
    bar.add_widget(lbl(title, color=(1,1,1,1), size=18, bold=True))
    bar.add_widget(right_widget if right_widget else Label())
    return bar

def scroll():
    sv = ScrollView()
    inner = BoxLayout(orientation='vertical', size_hint_y=None, spacing=dp(8),
                      padding=dp(10))
    inner.bind(minimum_height=lambda *a: setattr(inner, 'height', inner.minimum_height))
    sv.add_widget(inner)
    return sv, inner

def toast(text):
    p = Popup(title='', content=lbl(text, size=14),
              size_hint=(0.8, 0.3), background_color=C_CARD)
    p.open()
    from kivy.clock import Clock
    Clock.schedule_once(lambda dt: p.dismiss(), 2.0)


