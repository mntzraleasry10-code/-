class LoginScreen(Screen):
    def __init__(self, **kw):
        super().__init__(**kw)
        root = BoxLayout(orientation='vertical', padding=dp(20), spacing=dp(12),
                         size_hint_y=None)
        root.bind(minimum_height=lambda *a: setattr(root, 'height', root.minimum_height))
        sv = ScrollView()
        sv.add_widget(root)
        self.add_widget(sv)

        root.add_widget(Label(size_hint_y=None, height=dp(40)))
        root.add_widget(lbl('🩺', size=64, halign='center'))
        root.add_widget(lbl('Doctor Booking Iraq', size=24, bold=True, halign='center',
                            color=C_PRIMARY))
        root.add_widget(lbl('Book appointments across Iraq', size=13, halign='center',
                            color=C_MUTED))
        root.add_widget(Label(size_hint_y=None, height=dp(20)))

        self.phone = TextInput(hint_text='Phone or Email', multiline=False,
                               size_hint_y=None, height=dp(48),
                               padding=[dp(12), dp(12)])
        self.pw = TextInput(hint_text='Password', password=True, multiline=False,
                            size_hint_y=None, height=dp(48),
                            padding=[dp(12), dp(12)])
        root.add_widget(self.phone)
        root.add_widget(self.pw)

        root.add_widget(btn('Login', on_press=self.do_login))
        root.add_widget(btn('Create Account', bg=C_SECONDARY,
                            on_press=lambda: setattr(self.manager, 'current', 'register')))
        root.add_widget(Label(size_hint_y=None, height=dp(20)))

        demo = card(bg=get_color_from_hex('#EAF2FA'))
        demo.add_widget(lbl('Demo: 07701234567 / 1234', color=C_MUTED, size=12))
        root.add_widget(demo)

    def do_login(self):
        from app_globals import AppState
        u = self.phone.text.strip()
        p = self.pw.text.strip()
        if not u or not p:
            toast('Enter phone/email and password')
            return
        row = DB.q1("SELECT * FROM patients WHERE phone=? OR email=?", (u, u))
        if not row or row['password'] != p:
            toast('Invalid credentials')
            return
        AppState.patient_id = row['id']
        AppState.patient_name = row['name']
        self.phone.text = ''; self.pw.text = ''
        self.manager.current = 'home'


class RegisterScreen(Screen):
    def __init__(self, **kw):
        super().__init__(**kw)
        root = BoxLayout(orientation='vertical', padding=dp(20), spacing=dp(10),
                         size_hint_y=None)
        root.bind(minimum_height=lambda *a: setattr(root, 'height', root.minimum_height))
        sv = ScrollView(); sv.add_widget(root)
        self.add_widget(sv)

        root.add_widget(lbl('Create Account', size=22, bold=True, color=C_PRIMARY))
        root.add_widget(Label(size_hint_y=None, height=dp(10)))

        self.name = TextInput(hint_text='Full Name', size_hint_y=None,
                              height=dp(46), padding=[dp(12), dp(10)])
        self.phone = TextInput(hint_text='Phone (e.g. 07701234567)', size_hint_y=None,
                               height=dp(46), padding=[dp(12), dp(10)])
        self.email = TextInput(hint_text='Email', size_hint_y=None,
                               height=dp(46), padding=[dp(12), dp(10)])
        self.pw = TextInput(hint_text='Password', password=True, size_hint_y=None,
                            height=dp(46), padding=[dp(12), dp(10)])
        for w in (self.name, self.phone, self.email, self.pw):
            root.add_widget(w)

        root.add_widget(Label(size_hint_y=None, height=dp(10)))
        root.add_widget(btn('Register', bg=C_SECONDARY, on_press=self.do_register))
        root.add_widget(btn('Back to Login', bg=C_MUTED,
                            on_press=lambda: setattr(self.manager, 'current', 'login')))

    def do_register(self):
        from app_globals import AppState
        n = self.name.text.strip(); ph = self.phone.text.strip()
        e = self.email.text.strip(); pw = self.pw.text.strip()
        if not n or not ph or not pw:
            toast('Name, phone and password are required'); return
        if not ph.isdigit() or len(ph) < 10:
            toast('Phone must be at least 10 digits'); return
        try:
            pid = DB.ex("INSERT INTO patients(name,phone,email,password,created_at) VALUES(?,?,?,?,?)",
                        (n, ph, e, pw, datetime.now().isoformat()))
        except sqlite3.IntegrityError:
            toast('Phone already registered'); return
        AppState.patient_id = pid
        AppState.patient_name = n
        for w in (self.name, self.phone, self.email, self.pw):
            w.text = ''
        self.manager.current = 'home'


