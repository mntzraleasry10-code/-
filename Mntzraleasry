class SearchScreen(Screen):
    def __init__(self, **kw):
        super().__init__(**kw)
        self.preset_specialty = ''
        self.root_box = BoxLayout(orientation='vertical')
        self.add_widget(self.root_box)

    def on_pre_enter(self):
        self.build()

    def build(self):
        self.root_box.clear_widgets()
        self.root_box.add_widget(topbar('Search Doctors',
                                        on_back=lambda: setattr(self.manager, 'current', 'home')))

        filters = BoxLayout(size_hint_y=None, height=dp(50), spacing=dp(4), padding=dp(4))
        self.q = TextInput(hint_text='Name / specialty', multiline=False)
        self.city = Spinner(text='All Cities', values=['All Cities','Baghdad','Basra','Erbil','Najaf','Karbala'],
                            size_hint_x=0.4)
        filters.add_widget(self.q)
        filters.add_widget(self.city)
        self.root_box.add_widget(filters)

        row2 = BoxLayout(size_hint_y=None, height=dp(44), spacing=dp(4), padding=dp(4))
        self.max_fee = Spinner(text='Any Price', values=['Any Price','10,000','15,000','20,000','25,000','30,000'])
        self.min_rating = Spinner(text='Any Rating', values=['Any Rating','3+','4+','4.5+'])
        apply_b = btn('Apply', height=dp(38), size_hint_x=0.3, on_press=self.run_search)
        row2.add_widget(self.max_fee)
        row2.add_widget(self.min_rating)
        row2.add_widget(apply_b)
        self.root_box.add_widget(row2)

        self.sv, self.results = scroll()
        self.root_box.add_widget(self.sv)
        self.q.text = self.preset_specialty
        self.run_search()

    def run_search(self):
        self.results.clear_widgets()
        sql = "SELECT * FROM doctors WHERE 1=1"
        params = []
        if self.q.text.strip():
            sql += " AND (name LIKE ? OR specialty LIKE ? OR clinic LIKE ?)"
            v = f"%{self.q.text.strip()}%"
            params += [v, v, v]
        if self.city.text != 'All Cities':
            sql += " AND city = ?"
            params.append(self.city.text)
        if self.max_fee.text != 'Any Price':
            sql += " AND fee <= ?"
            params.append(int(self.max_fee.text.replace(',', '')))
        if self.min_rating.text != 'Any Rating':
            sql += " AND rating >= ?"
            params.append(float(self.min_rating.text.replace('+', '')))
        rows = DB.q(sql + " ORDER BY rating DESC", params)
        if not rows:
            empty = card()
            empty.add_widget(lbl('No doctors match your search', size=14, color=C_MUTED, halign='center'))
            empty.add_widget(lbl('Try a different filter or clear the search', size=12, color=C_MUTED, halign='center'))
            self.results.add_widget(empty)
            return
        for d in rows:
            c = card(height=dp(110))
            c.add_widget(lbl(d['name'], size=14, bold=True))
            c.add_widget(lbl(f"{d['specialty']} • {d['clinic']}", size=12, color=C_MUTED))
            c.add_widget(lbl(f"{d['city']} • {d['fee']} IQD • ⭐ {d['rating']:.1f} ({d['rating_count']})",
                             size=11, color=C_MUTED))
            b = btn('View Profile', height=dp(32), on_press=lambda *a, did=d['id']: self.open(did))
            c.add_widget(b)
            self.results.add_widget(c)

    def open(self, did):
        self.manager.get_screen('doctor').doctor_id = did
        self.manager.current = 'doctor'


